{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.copado/agentia-cli",
  "title": "Copado Agentia",
  "description": "Run Copado DevOps tasks from MCP-capable AI agents through the Agentia CLI local MCP server.",
  "version": "1.15.0",
  "websiteUrl": "https://developer.copado.com/docs",
  "repository": {
    "url": "https://github.com/CopadoSolutions/agentia-cli-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@copado/agentia-cli",
      "version": "1.15.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "positional",
          "value": "start"
        }
      ]
    }
  ]
}
